# UAB v0.3 demo configuration — copy to .env and change before production.
UAB_ENV=development
UAB_PORT=8787
UAB_PUBLIC_ORIGIN=http://localhost:8787

# Dashboard demo credentials
UAB_DEMO_ADMIN_EMAIL=admin@uab.demo
UAB_DEMO_ADMIN_PASSWORD=ChangeMe-Demo-Admin-123!
UAB_DEMO_AUDITOR_EMAIL=auditor@uab.demo
UAB_DEMO_AUDITOR_PASSWORD=ChangeMe-Demo-Auditor-123!
UAB_DEMO_VIEWER_EMAIL=viewer@uab.demo
UAB_DEMO_VIEWER_PASSWORD=ChangeMe-Demo-Viewer-123!

# Secrets — DEMO ONLY. Replace with long random secrets in production.
UAB_SESSION_SECRET=demo-session-secret-change-me-at-least-32-chars
UAB_EVENT_SIGNING_KEY=demo-event-signing-key-change-me
UAB_POLICY_SIGNING_KEY=demo-policy-signing-key-change-me

# Session / security
UAB_SESSION_TTL_SECONDS=28800
UAB_COOKIE_SECURE=false
UAB_LOGIN_MAX_ATTEMPTS=8
UAB_LOGIN_WINDOW_SECONDS=900

# Storage: memory | postgres | clickhouse
UAB_STORAGE_DRIVER=memory
UAB_DATABASE_URL=postgres://uab:uab_demo_password@localhost:5432/uab
UAB_CLICKHOUSE_URL=http://localhost:8123
UAB_CLICKHOUSE_DATABASE=uab
UAB_CLICKHOUSE_USER=uab
UAB_CLICKHOUSE_PASSWORD=uab_demo_password

# Retention
UAB_RETENTION_DAYS=90

# Alerts
UAB_ALERT_DRIFT_RATE=0.01
UAB_ALERT_BLOCKS_PER_MINUTE=100
UAB_ALERT_WEBHOOK_URL=

# Demo tenant
UAB_DEMO_TENANT_ID=demo
UAB_DEMO_TENANT_NAME=UAB Demo Tenant
